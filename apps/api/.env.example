# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database — local docker-compose Postgres by default during development.
# Swap to the Supabase connection string (Project Settings > Database) once credentials are ready.
DATABASE_URL=postgresql://ai_tutor:ai_tutor_dev_password@localhost:5432/ai_tutor_dev

# Supabase (Auth + Storage) — fill in after creating the Supabase project
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > API > JWT Settings > JWT Secret — used to verify user JWTs locally without a network round trip
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=materials

# AI providers — free tiers (see docs/02-DECISIONS-LOG.md decision A1/D7)
GEMINI_API_KEY=
GROQ_API_KEY=

# Observability (optional — app must work without these, see decision D14)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
