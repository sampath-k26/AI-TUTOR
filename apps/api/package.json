{
  "name": "@ai-tutor/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/core/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "eval": "tsx scripts/runEval.ts",
    "worker": "tsx watch src/workers/runWorker.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "cors": "^2.8.6",
    "helmet": "^8.3.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.5",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "pg-boss": "^10.4.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "@supabase/supabase-js": "2.109.0",
    "@google/genai": "^2.22.0",
    "groq-sdk": "^1.6.0",
    "pdfjs-dist": "5.5.207",
    "@napi-rs/canvas": "^1.0.9"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11",
    "supertest": "^7.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.70.0",
    "@types/express": "^5.0.6",
    "@types/cors": "^2.8.19",
    "@types/multer": "^2.2.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/node": "^20.19.0",
    "@types/supertest": "^7.2.1"
  }
}
